spring:
  datasource:
    url: jdbc:postgresql://localhost:5432/gxt
    username: postgres
    password: postgres
    driver-class-name: org.postgresql.Driver
  jpa:
    hibernate:
      ddl-auto: validate
    open-in-view: false
    properties:
      hibernate:
        jdbc:
          time_zone: UTC
  flyway:
    enabled: true
    locations: classpath:db/migration

gxt:
  jwt:
    secret: ${GXT_JWT_SECRET:local-dev-only-change-me-32chars-min}
  otp:
    delivery: log

spring.ai:
  anthropic:
    api-key: ${ANTHROPIC_API_KEY:}
    chat:
      options:
        model: claude-3-5-sonnet-20241022

logging:
  level:
    com.gxt: DEBUG
